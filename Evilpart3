-- ============ PORTAL GUN ============
local PG={portals={},given=false,equipped=false}

function PG.SpawnPortalAt(pos,normal)
    if #PG.portals>=2 then
        local old=table.remove(PG.portals,1)
        if old and old.Parent then old:Destroy() end
    end
    local p=Instance.new("Part")
    p.Name="EM_Portal"; p.Size=Vector3.new(0.2,8,8)
    p.Color=Color3.fromRGB(255,220,0); p.Material=Enum.Material.Neon
    p.Transparency=0.15; p.CanCollide=false; p.Anchored=true; p.CanQuery=false
    local up=normal.Unit
    local look=Vector3.new(0,0,-1)
    if math.abs(up.Y)>0.9 then look=Vector3.new(1,0,0) end
    local right=look:Cross(up).Unit
    local nl=up:Cross(right).Unit
    p.CFrame=CFrame.new(pos+normal*0.2,pos+normal*0.2+nl,up)
    p.Parent=workspace
    local l=Instance.new("PointLight")
    l.Color=Color3.fromRGB(255,220,0); l.Brightness=8; l.Range=25; l.Parent=p
    local a=Instance.new("Attachment"); a.Parent=p
    local e=Instance.new("ParticleEmitter")
    e.Texture="rbxasset://textures/particles/sparkles_main.dds"
    e.Color=ColorSequence.new(Color3.fromRGB(255,220,0))
    e.Rate=50; e.Lifetime=NumberRange.new(0.8,1.5)
    e.Speed=NumberRange.new(2,4); e.Size=NumberSequence.new(0.4)
    e.LightEmission=1; e.Parent=a
    table.insert(PG.portals,p)
    task.delay(20,function() if p and p.Parent then p:Destroy() end end)
end

function PG.ShootFromScreen(x,y)
    local ray=cam:ViewportPointToRay(x,y)
    local hit,hp,hn=U.ray(ray.Origin,ray.Direction*500)
    if hit then PG.SpawnPortalAt(hp,hn)
    else
        local hrp=U.getHRP(LP)
        if hrp then
            local front=hrp.CFrame.Position+hrp.CFrame.LookVector*15
            local safe=U.rayGround(front)
            PG.SpawnPortalAt(safe,Vector3.new(0,1,0))
        end
    end
end

function PG.ShootFromCameraCenter()
    local v=cam.ViewportSize
    PG.ShootFromScreen(v.X/2,v.Y/2)
end

table.insert(C.tapHandlers,function(x,y)
    if PG.equipped then PG.ShootFromScreen(x,y) end
end)

function PG.Give()
    local ch=LP.Character; if not ch then return end
    local bp=LP:FindFirstChildOfClass("Backpack"); if not bp then return end
    local ex=bp:FindFirstChild("Portal Gun") or ch:FindFirstChild("Portal Gun")
    if ex then ex.Parent=ch PG.given=true return end
    local tool=Instance.new("Tool")
    tool.Name="Portal Gun"; tool.RequiresHandle=true
    tool.CanBeDropped=false; tool.ToolTip="Evil Morty Portal Gun"
    local h=Instance.new("Part")
    h.Name="Handle"; h.Size=Vector3.new(1.2,1.2,3)
    h.Color=Color3.fromRGB(40,40,40); h.Material=Enum.Material.Metal
    h.Parent=tool
    local b=Instance.new("Part")
    b.Name="Barrel"; b.Size=Vector3.new(0.8,0.8,2)
    b.Color=Color3.fromRGB(70,70,70); b.Material=Enum.Material.Metal
    b.CanCollide=false; b.Parent=tool
    local wb=Instance.new("Weld")
    wb.Part0=h; wb.Part1=b; wb.C0=CFrame.new(0,0,-1.5); wb.Parent=b
    local t=Instance.new("Part")
    t.Name="Tip"; t.Size=Vector3.new(0.9,0.9,0.9)
    t.Color=Color3.fromRGB(255,220,0); t.Material=Enum.Material.Neon
    t.Shape=Enum.PartType.Ball; t.CanCollide=false; t.Parent=tool
    local wt=Instance.new("Weld")
    wt.Part0=h; wt.Part1=t; wt.C0=CFrame.new(0,0,-2.8); wt.Parent=t
    local tl=Instance.new("PointLight")
    tl.Color=Color3.fromRGB(255,220,0); tl.Brightness=6; tl.Range=12; tl.Parent=t
    tool.Equipped:Connect(function()
        PG.equipped=true
        if C.fireBtn then C.fireBtn.Visible=true end
    end)
    tool.Unequipped:Connect(function()
        PG.equipped=false
        if C.fireBtn then C.fireBtn.Visible=false end
    end)
    tool.Activated:Connect(function() PG.ShootFromCameraCenter() end)
    tool.Parent=ch
    PG.given=true
end

function PG.GetLastPortal()
    for i=#PG.portals,1,-1 do
        local p=PG.portals[i]
        if p and p.Parent then return p end
    end
    return nil
end

function PG.Init() end
C.modules.PortalGun=PG

-- ============ ГОЛОГРАММА ЗЛОГО МОРТИ ============
local Holo={enabled=false,parts={}}
function Holo.Make()
    Holo.Destroy()
    local ch=LP.Character; if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    -- Голографический двойник: полупрозрачный неоновый силуэт
    local r15=ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
    local head=ch:FindFirstChild("Head")
    if not r15 or not head then return end
    local body=Instance.new("Part")
    body.Name="EM_Holo_Body"; body.Size=Vector3.new(2,2,1)
    body.Material=Enum.Material.ForceField
    body.Color=Color3.fromRGB(0,255,200); body.Transparency=0.6
    body.CanCollide=false; body.Anchored=false
    body.CFrame=r15.CFrame; body.Parent=ch
    local wb=Instance.new("Weld")
    wb.Part0=r15; wb.Part1=body; wb.C0=CFrame.new(); wb.C1=CFrame.new(); wb.Parent=body
    local hh=Instance.new("Part")
    hh.Name="EM_Holo_Head"; hh.Shape=Enum.PartType.Ball
    hh.Size=Vector3.new(1.4,1.4,1.4)
    hh.Material=Enum.Material.ForceField
    hh.Color=Color3.fromRGB(0,255,200); hh.Transparency=0.5
    hh.CanCollide=false; hh.CFrame=head.CFrame; hh.Parent=ch
    local wh=Instance.new("Weld")
    wh.Part0=head; wh.Part1=hh; wh.C0=CFrame.new(); wh.C1=CFrame.new(); wh.Parent=hh
    local l1=Instance.new("PointLight")
    l1.Color=Color3.fromRGB(0,255,200); l1.Brightness=4; l1.Range=12; l1.Parent=body
    local l2=Instance.new("PointLight")
    l2.Color=Color3.fromRGB(0,255,200); l2.Brightness=3; l2.Range=8; l2.Parent=hh
    table.insert(Holo.parts,body); table.insert(Holo.parts,hh)
end
function Holo.Destroy()
    for _,p in pairs(Holo.parts) do
        if p and p.Parent then p:Destroy() end
    end
    Holo.parts={}
end
function Holo.Enable() Holo.enabled=true Holo.Make() end
function Holo.Disable() Holo.enabled=false Holo.Destroy() end
function Holo.Toggle() if Holo.enabled then Holo.Disable() else Holo.Enable() end end
function Holo.Init()
    LP.CharacterAdded:Connect(function()
        if Holo.enabled then task.wait(1) Holo.Make() end
    end)
end

-- ============ ESP (дистанция над игроками) ============
local ESP={enabled=false}
function ESP.Init()
    spawn(function()
        while task.wait(0.4) do
            for _,p in pairs(C.Players:GetPlayers()) do
                if p==LP then continue end
                local ch=p.Character; if not ch then continue end
                local hrp=ch:FindFirstChild("HumanoidRootPart")
                local head=ch:FindFirstChild("Head")
                if not hrp or not head then continue end
                local tag=head:FindFirstChild("EM_ESP")
                if ESP.enabled then
                    if not tag then
                        local bb=Instance.new("BillboardGui")
                        bb.Name="EM_ESP"; bb.Size=UDim2.new(0,120,0,20)
                        bb.StudsOffset=Vector3.new(0,4.5,0); bb.AlwaysOnTop=true
                        bb.Parent=head
                        local t=Instance.new("TextLabel")
                        t.Size=UDim2.new(1,0,1,0); t.BackgroundTransparency=1
                        t.TextColor3=Color3.fromRGB(0,255,255)
                        t.Font=Enum.Font.Code; t.TextSize=13
                        t.Text=""; t.Parent=bb
                    end
                    local myHrp=U.getHRP(LP)
                    if myHrp and tag then
                        local dist=(hrp.Position-myHrp.Position).Magnitude
                        tag.TextLabel.Text=math.floor(dist).." studs"
                    end
                else
                    if tag then tag:Destroy() end
                end
            end
        end
    end)
end
function ESP.Enable() ESP.enabled=true end
function ESP.Disable() ESP.enabled=false end
function ESP.Toggle() if ESP.enabled then ESP.Disable() else ESP.Enable() end end

-- ============ FLIGHT ============
local Fly={enabled=false,conn=nil}
function Fly.Enable()
    local ch=LP.Character; if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    Fly.enabled=true
    local bodyVel=Instance.new("BodyVelocity")
    bodyVel.Name="EM_FlyVel"; bodyVel.MaxForce=Vector3.new(1e5,1e5,1e5)
    bodyVel.Velocity=Vector3.new(0,0,0); bodyVel.Parent=hrp
    local bg=Instance.new("BodyGyro")
    bg.Name="EM_FlyGyro"; bg.MaxTorque=Vector3.new(1e5,1e5,1e5)
    bg.P=1000; bg.D=50; bg.CFrame=hrp.CFrame; bg.Parent=hrp
    Fly.conn=RunService.RenderStepped:Connect(function()
        if not Fly.enabled then return end
        local c=LP.Character; if not c then return end
        local h=c:FindFirstChild("HumanoidRootPart"); if not h then return end
        local dir=Vector3.new(0,0,0)
        local cf=cam.CFrame
        if C.UIS:IsKeyDown(Enum.KeyCode.W) then dir=dir+cf.LookVector end
        if C.UIS:IsKeyDown(Enum.KeyCode.S) then dir=dir-cf.LookVector end
        if C.UIS:IsKeyDown(Enum.KeyCode.A) then dir=dir-cf.RightVector end
        if C.UIS:IsKeyDown(Enum.KeyCode.D) then dir=dir+cf.RightVector end
        if dir.Magnitude>0 then dir=dir.Unit end
        local v=hrp:FindFirstChild("EM_FlyVel")
        local g=hrp:FindFirstChild("EM_FlyGyro")
        if v then v.Velocity=dir*60+Vector3.new(0,10,0) end
        if g then g.CFrame=cf end
    end)
end
function Fly.Disable()
    Fly.enabled=false
    if Fly.conn then Fly.conn:Disconnect() Fly.conn=nil end
    local ch=LP.Character; if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if hrp:FindFirstChild("EM_FlyVel") then hrp.EM_FlyVel:Destroy() end
    if hrp:FindFirstChild("EM_FlyGyro") then hrp.EM_FlyGyro:Destroy() end
end
function Fly.Toggle() if Fly.enabled then Fly.Disable() else Fly.Enable() end end

-- ============ SPEED ============
local Speed={enabled=false,val=16}
function Speed.Set(v)
    Speed.val=v
    local ch=LP.Character; if not ch then return end
    local hum=ch:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.WalkSpeed=v
end
function Speed.Enable() Speed.enabled=true Speed.Set(120) end
function Speed.Disable() Speed.enabled=false Speed.Set(16) end
function Speed.Toggle() if Speed.enabled then Speed.Disable() else Speed.Enable() end end

-- ============ NOCLIP ============
local Noclip={enabled=false,conn=nil}
function Noclip.Enable()
    Noclip.enabled=true
    Noclip.conn=RunService.Stepped:Connect(function()
        local ch=LP.Character; if not ch then return end
        for _,p in pairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide=false
            end
        end
    end)
end
function Noclip.Disable()
    Noclip.enabled=false
    if Noclip.conn then Noclip.conn:Disconnect() Noclip.conn=nil end
end
function Noclip.Toggle() if Noclip.enabled then Noclip.Disable() else Noclip.Enable() end end

-- ============ AUTO TAP ============
local AutoTap={enabled=false,conn=nil}
function AutoTap.Enable()
    AutoTap.enabled=true
    local vu=game:GetService("VirtualUser")
    AutoTap.conn=RunService.Heartbeat:Connect(function()
        pcall(function() vu:CaptureController() vu:ClickButton2(Vector2.new()) end)
    end)
end
function AutoTap.Disable()
    AutoTap.enabled=false
    if AutoTap.conn then AutoTap.conn:Disconnect() AutoTap.conn=nil end
end
function AutoTap.Toggle() if AutoTap.enabled then AutoTap.Disable() else AutoTap.Enable() end end

